# Policy-Driven Data Governance Platform - Environment Configuration

# Node Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://governance:governance123@postgres:5432/governance_db
DB_HOST=postgres
DB_PORT=5432
DB_USER=governance
DB_PASSWORD=governance123
DB_NAME=governance_db

# OPA (Open Policy Agent) Configuration
OPA_URL=http://opa:8181
OPA_POLICY_PATH=/policies
OPA_DECISION_TIMEOUT=5000

# Apicurio Registry Configuration
APICURIO_URL=http://apicurio-registry:8080
APICURIO_GROUP=governance

# Security
SECRET_KEY=change-this-in-production-to-a-random-string
JWT_SECRET=jwt-secret-key-change-in-production
JWT_EXPIRY=24h

# Audit Configuration
AUDIT_RETENTION_YEARS=7
AUDIT_LOG_LEVEL=info

# API Configuration
API_RATE_LIMIT=100
API_TIMEOUT=30000

# Feature Flags
ENABLE_AI_GOVERNANCE=false
ENABLE_AUDIT_TRAIL=true
ENABLE_SCHEMA_VALIDATION=true
